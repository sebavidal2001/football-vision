# Copia questo file in:  scout_lab/data/secrets.env   (quella cartella è ignorata da git)
# e incolla i tuoi valori. NON mettere la chiave in chat o nel repository.

RUNPOD_API_KEY=incolla_qui_la_tua_api_key_runpod

# Percorso della tua chiave SSH PRIVATA (quella pubblica va caricata su RunPod).
# Windows esempio:  C:/Users/sebav/.ssh/id_ed25519
RUNPOD_SSH_KEY=C:/Users/sebav/.ssh/id_ed25519

# GPU da usare (vedi nomi su runpod.io). Opzioni comuni:
#   "NVIDIA GeForce RTX 4090"  (veloce, consigliata)
#   "NVIDIA GeForce RTX 3090"  (più economica)
RUNPOD_GPU=NVIDIA GeForce RTX 4090

# Tipo di cloud: COMMUNITY (economico) o SECURE (più stabile/caro)
RUNPOD_CLOUD=COMMUNITY
